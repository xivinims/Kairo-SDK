{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeno",
  "version": "0.2.0",
  "identifier": "space.kaise.zeno",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 8080",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Zeno",
      "width": 1400,
      "height": 900,
      "minWidth": 860,
      "minHeight": 620,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": []
  }
}
