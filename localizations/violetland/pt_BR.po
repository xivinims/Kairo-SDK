#: ../src/program.cpp:606
msgid ""
"Unstoppable: enemies can't block your movement any more, but they still can "
"hurt you."
msgstr ""
"Imparável: os inimigos não conseguem mais bloquear seu movimento, mas ainda "
"podem ferir você."

#: ../src/program.cpp:616
msgid ""
"Poison bullets: after getting hit by your bullet, enemies slowly lose health "
"until they die."
msgstr ""
"Projéteis venenosos: depois de serem atingidos, os inimigos perdem vida "
"lentamente até serem derrotados."

#: ../src/program.cpp:626
msgid "Big calibre: your bullets can wound a few monsters in a row."
msgstr "Grande calibre: seus disparos podem atingir vários monstros em sequência."

#: ../src/program.cpp:636
msgid "Telekinesis: useful things slowly move towards you."
msgstr "Telecinese: itens úteis se movem lentamente em sua direção."

#: ../src/program.cpp:645
msgid "Night vision: you can see in the dark."
msgstr "Visão noturna: você consegue enxergar no escuro."

#: ../src/program.cpp:654
msgid "Looting: Monsters will drop more bonuses."
msgstr "Saque: os monstros deixarão mais bônus."

#: ../src/program.cpp:664
msgid "Wide sight: accessible area for action is much more."
msgstr "Visão ampliada: a área de ação ao seu alcance fica muito maior."

